# Copy this file to .env and adjust values before running `docker compose up --build`.
# Never commit the real .env file.

# ---- PostgreSQL ----
POSTGRES_DB=jobforge
POSTGRES_USER=jobforge
POSTGRES_PASSWORD=change_me_dev_password

# ---- JWT (API + auth) ----
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters_long
JWT_ISSUER=JobForge
JWT_AUDIENCE=JobForge

# ---- Networking ----
# Host ports exposed by docker-compose.
API_PORT=8080
FRONTEND_PORT=3000

# Origin the API's CORS policy allows (the frontend's externally-reachable URL).
FRONTEND_URL=http://localhost:3000

# URL the BROWSER uses to reach the API — baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Worker ----
# Leave WORKER_ID unset to auto-generate one per container (required for `--scale worker=N`).
WORKER_ID=
POLL_INTERVAL_SECONDS=2
STALE_EXECUTION_THRESHOLD_SECONDS=120

# Run EF Core migrations automatically when the API container starts.
# Turned on here for a one-command local/demo setup; see ENGINEERING.md "Database Decisions"
# for why this is an explicit opt-in rather than an implicit EnsureCreated()/always-on default.
APPLY_MIGRATIONS_ON_STARTUP=true
